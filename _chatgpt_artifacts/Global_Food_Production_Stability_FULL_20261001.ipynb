    "CATEGORY_PREFIX={'农业与土地':'AGR','水资源与生态环境':'ENV','人口与城镇化':'POP','经济发展与产业结构':'ECO','贸易与全球化':'TRD','金融与宏观稳定':'FIN','基础设施与数字化':'INF','制度与治理':'GOV','社会与人力资本':'SOC','能源与资源利用':'ENE','其他':'OTH'}\n",
