    "spatial_importance=shap_group_importance('Spatial_group',['Global North','Global South']); spatial_importance.to_csv(TABLE_DIR/'Global_North_South_SHAP_importance.csv',index=False,encoding='utf-8-sig')\n",
    "continent_groups=[x for x in ['Africa','Asia','Europe','Americas','Oceania'] if (shap_sample.Continent_group==x).sum()>=MIN_HETERO_N]; continent_importance=shap_group_importance('Continent_group',continent_groups); continent_importance.to_csv(TABLE_DIR/'Continental_SHAP_importance.csv',index=False,encoding='utf-8-sig')\n",
